{
  "window.title": "${rootName}",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "all",
  "editor.renderControlCharacters": true,
  "editor.formatOnSave": true,
  "editor.wordWrap": "off",
  "editor.tabSize": 2,
  "editor.fontSize": 14,
  "editor.fontFamily": "MesloLGS Nerd Font",
  "editor.acceptSuggestionOnEnter": "smart",
  "search.exclude": {
    "**/*.svg": true,
    "docs/godocs/**": true
  },
  "chat.agentsControl.enabled": "hidden",
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true
  },
  "git.autofetch": false,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.branchProtection": [
    "main"
  ],
  "workbench.startupEditor": "none",
  "workbench.iconTheme": "vscode-icons",
  "workbench.colorTheme": "Flexoki Dark",
  "terminal.integrated.fontFamily": "MesloLGS Nerd Font Mono",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.profiles.windows": {
    "pwsh": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.suggest.enabled": false,
  "powershell.startAutomatically": true,
  "powershell.integratedConsole.showOnStartup": false,
  "powershell.enableProfileLoading": true,
  "go.testFlags": [
    "-tags=integration"
  ],
  "gopls": {
    "build.buildFlags": [
      "-tags=integration"
    ],
    "standaloneTags": [
      "ignore"
    ]
  },
  "cSpell.words": [
    "apispecifications",
    "applog",
    "atomicfile",
    "builderdeployment",
    "CRDT",
    "cutover",
    "DACL",
    "danielgtaylor",
    "deadcode",
    "depguard",
    "eventfabric",
    "eventmodel",
    "eventstore",
    "fabricolric",
    "fe3dback",
    "filelock",
    "gocache",
    "gohcl",
    "golangci",
    "gopls",
    "gotest",
    "gotestsum",
    "GOWORK",
    "hclparse",
    "httpapi",
    "huma",
    "humago",
    "idempotently",
    "jetstream",
    "jsonfields",
    "Kiota",
    "LASTEXITCODE",
    "lintcache",
    "logscan",
    "matejovsky",
    "memberlist",
    "mirmat",
    "miroslav",
    "olric",
    "omitempty",
    "opdl",
    "pkgname",
    "platformapi",
    "platformdeployment",
    "processinfo",
    "processtree",
    "procrun",
    "promotability",
    "slnx",
    "stdlib",
    "stretchr",
    "taskfile",
    "testname",
    "unioned",
    "winmutex",
    "winservice",
    "Xunit"
  ]
}