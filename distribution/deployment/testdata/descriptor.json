{
  "platform": "acme-opdl",
  "project": "customer-a",
  "environment": "production",
  "site": "north",
  "machine": "sensor-01",
  "role": "sensor-node",
  "features": {
    "opcua": true,
    "alarms": false,
    "recording": true,
    "analytics": false,
    "historian": false,
    "chaos": true
  },
  "enabled_services": [
    "sensor-service",
    "opcua-adapter"
  ],
  "services": [
    {
      "name": "opcua-adapter",
      "endpoint": "opc.tcp://plc-north-01:4840",
      "namespace": "2",
      "interval": "1s"
    }
  ],
  "database": {
    "provider": "postgres",
    "host": "db.customer-a.local",
    "port": 5432
  },
  "runtime": {
    "parameters": [
      {
        "key": "http_addr",
        "default": "127.0.0.1:8080",
        "owner": "deployment",
        "override": true
      },
      {
        "key": "log_level",
        "default": "info",
        "owner": "deployment",
        "override": true
      }
    ]
  }
}
