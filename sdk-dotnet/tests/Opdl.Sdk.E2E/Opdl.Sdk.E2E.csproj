<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end tests that drive a running platform through the generated SDK. They
    are executed by the scenarios module (scenarios/sdk), which builds the platform,
    starts it, and passes its address in OPDL_PLATFORM_BASEURL. Run standalone
    without that variable, the tests skip.

    test.runsettings makes a run that discovers no test fail; see the file for why.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Opdl.Sdk\Opdl.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
