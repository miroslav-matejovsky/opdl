<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OPDL platform SDK for .NET. The HTTP client under Client/ is generated by
    Kiota from api-specifications/openapi.yaml; regeneration is driven by the conformance-tests
    module (see sdk-dotnet/README.md). Kiota.Bundle brings the abstractions, HTTP
    adapter, and serializers the generated code compiles and runs against.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Opdl.Sdk</RootNamespace>
    <AssemblyName>Opdl.Sdk</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.0.0" />
  </ItemGroup>

</Project>
