# Scenario blueprint template.
#
# The .tmpl extension is deliberate. The builder loads every *.hcl file in a
# blueprint directory, so an unrendered template must not look like one.
#
# Everything else is authored per fixture in the harness's fixture model, which
# is the single source of each machine's name, address, and standby policy.
project "{{ .Name }}" {
  environment = "development"

  site "{{ .Site }}" {
{{- range .Machines }}
    machine "{{ .Name }}" {
      profile  = "all-in-one"
      ip       = "{{ .IP }}"
      services = ["core-services"]

      platform {
        # The blocks directly under platform are the Primary Instance's; standby
        # carries the Standby Instance's. Every port is reserved separately by the
        # harness, because the two instances run together on one host.
        #
        # events_file and state_file are per instance for the same reason the
        # ports are: several machines share one host here, so the harness renders
        # a distinct path for every file of every instance of every machine.
        #
        # The platform installs and manages no services; the winservice names are
        # carried into the manifest so the roles are named consistently. The
        # namespace token keeps concurrent scenario runs from naming the same
        # service twice.
        # machine_events_file is the machine's own store, not an instance's: both
        # instances append their machine-scoped events to it, and every machine
        # authors one whether or not it deploys a standby.
        machine_events_file = "{{ .MachineEventsFile }}"
        events_file         = "{{ .EventsFile }}"
        state_file          = "{{ .StateFile }}"

        # The listener timeouts are per instance, and every setting a machine
        # runs with is compiled into its binary: a scenario launches a built
        # machine with nothing but its instance role.
        api {
          local_port          = {{ .APIPort }}
          read_header_timeout = "5s"
          shutdown_timeout    = "10s"
        }

        winservice {
          name         = "{{ $.RunToken }}-{{ $.Name }}-{{ .Name }}-primary"
          display_name = "OPDL {{ $.Name }} {{ .Name }} (Primary Instance)"
        }

        standby {
          disabled = {{ .StandbyDisabled }}
{{- if not .StandbyDisabled }}
          events_file = "{{ .StandbyEventsFile }}"
          state_file  = "{{ .StandbyStateFile }}"

          # The lease timings are deliberately much shorter than a production
          # blueprint's: a redundancy scenario waits out real lapses and real
          # stabilization windows, and at production pace one failover-and-back
          # would take a minute of wall clock without testing anything more.
          #
          # lag_bound goes the other way, and is deliberately looser than a
          # production blueprint's 30s. It bounds how long a machine puts up with
          # a slow environment before it stops being promotable, and a scenario
          # suite is a slow environment on purpose: it builds the platform and
          # starts it on a busy host. No scenario asserts on the bound, so
          # raising it removes a false failure without weakening anything. A
          # machine that genuinely never catches up still fails, on the assertion
          # that was actually being made.
          lease {
            file                   = "{{ .LeaseFile }}"
            duration               = "2s"
            renewal_interval       = "500ms"
            health_check_interval  = "250ms"
            failback_stabilization = "2s"
            lag_bound              = "2m"
          }

          api {
            local_port          = {{ .StandbyAPIPort }}
            read_header_timeout = "5s"
            shutdown_timeout    = "10s"
          }

          winservice {
            name         = "{{ $.RunToken }}-{{ $.Name }}-{{ .Name }}-standby"
            display_name = "OPDL {{ $.Name }} {{ .Name }} (Standby Instance)"
          }
{{- end }}
        }
      }
    }
{{ end }}  }
}
