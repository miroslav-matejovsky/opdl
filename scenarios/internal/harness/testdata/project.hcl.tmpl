# Scenario blueprint template.
#
# The .tmpl extension is deliberate. The builder loads every *.hcl file in a
# blueprint directory, so an unrendered template must not look like one.
#
# Everything else is authored per fixture in the harness's fixture model, which
# is the single source of each machine's name, address, and standby policy.
project "{{ .Name }}" {
  environment = "development"

  site "{{ .Site }}" {
    # The site's event fabric cluster. Every instance the scenario deploys joins
    # it, so the name is per run: two suites running at once on one host must not
    # end up with servers routing into each other's cluster.
    nats {
      cluster_name = "{{ .RunToken }}"
    }

{{- range .Machines }}
    machine "{{ .Name }}" {
      profile         = "all-in-one"
      ip              = "{{ .IP }}"
      eventstore_file = "{{ .MachineEventsFile }}"

      # The one service every scenario machine is authored with. Its port comes
      # from the same reservation as the platform's listeners, because a health
      # scenario binds a controllable service there and two runs sharing a host
      # must not both try. Nothing binds it in the scenarios that are about
      # something else, which is why those machines are authored with a slow
      # interval: they are watching a service that is not there.
      service "core-services" {
        role = "master"

        health_check {
          type     = "http"
          port     = {{ .HealthPort }}
          path     = "/health"
          interval = "{{ .HealthInterval }}"
          timeout  = "{{ .HealthTimeout }}"
          retries  = {{ .HealthRetries }}
        }
      }

      primary {
        eventlog_file = "{{ .EventsFile }}"
        state_file    = "{{ .StateFile }}"
        log_file      = "{{ .LogFile }}"

        api {
          local_port          = {{ .APIPort }}
          read_header_timeout = "5s"
          shutdown_timeout    = "10s"
        }

        # The instance's own embedded event fabric broker. Its cluster port is
        # reserved from the same loopback pool as the API port, because it is
        # the other listener the process binds.
        nats {
          cluster_port = {{ .NATSPort }}
        }

        winservice {
          name         = "{{ $.RunToken }}-{{ $.Name }}-{{ .Name }}-primary"
          display_name = "OPDL {{ $.Name }} {{ .Name }} (Primary Instance)"
        }
      }

      standby {
        disabled = {{ .StandbyDisabled }}
{{- if not .StandbyDisabled }}
        eventlog_file = "{{ .StandbyEventsFile }}"
        state_file    = "{{ .StandbyStateFile }}"
        log_file      = "{{ .StandbyLogFile }}"

        lease {
          file                   = "{{ .LeaseFile }}"
          duration               = "2s"
          renewal_interval       = "500ms"
          health_check_interval  = "250ms"
          failback_stabilization = "2s"
        }

        api {
          local_port          = {{ .StandbyAPIPort }}
          read_header_timeout = "5s"
          shutdown_timeout    = "10s"
        }

        nats {
          cluster_port = {{ .StandbyNATSPort }}
        }

        winservice {
          name         = "{{ $.RunToken }}-{{ $.Name }}-{{ .Name }}-standby"
          display_name = "OPDL {{ $.Name }} {{ .Name }} (Standby Instance)"
        }
{{- end }}
      }
    }
{{ end }}  }
}
