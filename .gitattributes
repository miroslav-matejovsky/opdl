# -------------------------------------------------------------------
# Global defaults
# -------------------------------------------------------------------
* text=auto

# -------------------------------------------------------------------
# Contracts
# -------------------------------------------------------------------
# Generated specifications are compared byte-for-byte by the conformance module's
# golden tests. Pin LF so a CRLF checkout on Windows (core.autocrlf=true) cannot
# make the checked-in contract differ from the freshly generated bytes.
api-specifications/**  text eol=lf

# -------------------------------------------------------------------
# Windows-Native / .NET / C#
# -------------------------------------------------------------------
*.ps1                   text eol=crlf
*.psm1                  text eol=crlf
*.psd1                  text eol=crlf

*.cs                    text eol=crlf linguist-language=C#
*.csx                   text eol=crlf linguist-language=C#
*.sln                   text eol=crlf
*.slnx                  text eol=crlf
*.csproj                text eol=crlf
*.fsproj                text eol=crlf
*.vbproj                text eol=crlf
*.props                 text eol=crlf
*.targets               text eol=crlf
*.proj                  text eol=crlf
*.config                text eol=crlf
*.xml                   text eol=crlf
*.xaml                  text eol=crlf
*.resx                  text eol=crlf
*.resw                  text eol=crlf
AssemblyInfo.cs         text eol=crlf

*.user                  text eol=crlf
*.rsuser                text eol=crlf
*.suo                   binary
*.snk                   binary

# C# Generated
*.g.cs                  linguist-generated
*.g.i.cs                linguist-generated
*.designer.cs           linguist-generated
*.generated.cs          linguist-generated
*.AssemblyAttributes.cs linguist-generated
*ModelSnapshot.cs       linguist-generated
Reference.cs            linguist-generated

# -------------------------------------------------------------------
# Go
# -------------------------------------------------------------------
*.go                    text linguist-language=Go
go.mod                  text
go.sum                  text
go.work                 text
go.work.sum             text

# Go Generated/Vendored
vendor/**               linguist-vendored
*_generated.go          linguist-generated
*_gen.go                linguist-generated
*.pb.go                 linguist-generated
*.mock.go               linguist-generated

# -------------------------------------------------------------------
# Web / Frontend (TS / JS / UI)
# -------------------------------------------------------------------
*.json                  text eol=lf
*.razor                 text eol=lf linguist-language=Razor
*.cshtml                text eol=crlf linguist-language=HTML
*.razor.css             text eol=lf

*.ts                    text eol=lf linguist-language=TypeScript
*.tsx                   text eol=lf linguist-language=TypeScript
*.js                    text eol=lf linguist-language=JavaScript
*.jsx                   text eol=lf linguist-language=JavaScript
*.mjs                   text eol=lf linguist-language=JavaScript
*.cjs                   text eol=lf linguist-language=JavaScript
*.cts                   text eol=lf linguist-language=TypeScript
*.mts                   text eol=lf linguist-language=TypeScript

# Frontend Generated/Vendored
*.min.js                linguist-generated
*.bundle.js             linguist-generated
*.chunk.js              linguist-generated
node_modules/**         linguist-vendored
wwwroot/lib/**          linguist-vendored

# -------------------------------------------------------------------
# Rust & Python
# -------------------------------------------------------------------
*.rs                    text eol=lf linguist-language=Rust
Cargo.toml              text
Cargo.lock              text
target/**               linguist-vendored
*_generated.rs          linguist-generated
*_gen.rs                linguist-generated

*.py                    text eol=lf

# -------------------------------------------------------------------
# Tooling / Scripts / Diagrams
# -------------------------------------------------------------------
.editorconfig           text eol=lf
*.sh                    text eol=lf
Makefile                text
*.mk                    text
*.d2                    text eol=lf

# -------------------------------------------------------------------
